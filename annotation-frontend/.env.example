ANNOTATION_ROOT=../llm-annotations
GCP_PROJECT_ID=moe-linebot-2025
FIRESTORE_DATABASE_ID=badminton-annotations
FIRESTORE_COLLECTION=badminton_vlm_annotations

# For local dev, point to a service account JSON file outside the repo.
FIRESTORE_SERVICE_ACCOUNT_PATH=/private/tmp/badminton-annotation-netlify-key.json

# For Netlify, set one of these in the Netlify UI as a secret environment variable.
FIRESTORE_SERVICE_ACCOUNT_JSON=
FIRESTORE_SERVICE_ACCOUNT_BASE64=
